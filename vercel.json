{
  "buildCommand": "chmod +x gradlew && ./gradlew :app:webApp:jsBrowserDistribution --no-daemon -Dorg.gradle.jvmargs=-Xmx2048m",
  "outputDirectory": "app/webApp/build/dist/js/productionExecutable",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
